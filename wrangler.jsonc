{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urgencemedicale",
  "compatibility_date": "2026-08-26",

  // The site is a static export; `worker/index.js` only exists to answer
  // /api/track (Phase 7 conversion tracking) and forwards everything else to
  // the assets binding untouched. See that file for why a Worker is needed at
  // all — the conversion is a phone tap, which cookie-less analytics cannot
  // observe.
  //
  // The presence of this file is also what stops `wrangler deploy` from
  // running its Next.js auto-config, which previously installed the OpenNext
  // adapter and then failed looking for .next/standalone SSR artifacts that a
  // static export never produces.
  "main": "worker/index.js",

  "assets": {
    "directory": "./out",
    // Exposes env.ASSETS so the Worker can serve the exported files.
    "binding": "ASSETS",
    // Serve out/404.html for unmatched paths (Next's exported 404 page).
    "not_found_handling": "404-page",

    // By default a matching asset is served BEFORE the Worker runs, so the
    // Worker's fetch handler never sees /admin/index.html and cannot set its
    // headers. /api/track only reached the Worker because no asset exists
    // there. Listing /admin/* here inverts that for the dashboard alone —
    // every public page keeps the default path and pays no Worker latency,
    // which matters on a site with an LCP budget.
    // MUST list every path the Worker owns, not just /admin. When this is an
    // array it is the EXCLUSIVE set of paths that reach the Worker first;
    // everything else is served by the asset server, and with
    // not_found_handling "404-page" an unmatched path gets the 404 page
    // without the Worker running at all.
    //
    // Adding only "/admin/*" here silently broke /api/track: the tracking
    // beacon started returning 404 and every tap, view and heartbeat was
    // dropped. The dashboard was correct and simply had nothing to show.
    "run_worker_first": ["/admin/*", "/api/*"]
  },

  /*
   * Where /api/track writes.
   *
   * Kept HERE rather than as a dashboard variable on purpose. Without it the
   * Worker still answers every beacon with 204 and simply drops the row —
   * `x-track-sink: log-only` — so tracking fails completely silently, and the
   * dashboard looks like a site with no visitors rather than a broken
   * pipeline. That is exactly what happened: the variable was never set, and
   * every view, ping and tap since launch went nowhere. In the repo it cannot
   * be forgotten and cannot be lost by a redeploy.
   *
   * Not a secret. This URL is already public in the admin page's Firebase SDK
   * config; the database is protected by its rules (writes open on the
   * tracking nodes, reads admin-only), not by the URL being unknown. Public
   * pages never see it — the beacon posts to /api/track on this origin.
   *
   * To verify after deploying:
   *   curl -sI "https://urgencemedicale.ma/api/track?e=view&p=/x" | grep x-track-sink
   * Expect `firebase`. `log-only` means this var is missing;
   * `firebase-failed` means it is set but the write was rejected.
   */
  "vars": {
    "FIREBASE_DB_URL": "https://urgencemedicale-8b903-default-rtdb.europe-west1.firebasedatabase.app"
  },

  "observability": {
    "enabled": true
  }

  /*
   * Durable record of every tap-to-call, so the operator can compare the
   * site's calls against the phone log.
   *
   * COMMENTED OUT ON PURPOSE: a d1_databases entry with a placeholder
   * database_id fails the deploy, and this Worker sits in front of a live
   * emergency service. The Worker checks for `env.DB` and degrades to Workers
   * Logs when it is absent, so the code is already correct without it.
   *
   * To switch it on:
   *   npx wrangler login
   *   npx wrangler d1 create urgencemedicale-taps
   * then paste the returned database_id here, uncomment, and redeploy.
   *
   * "d1_databases": [
   *   {
   *     "binding": "DB",
   *     "database_name": "urgencemedicale-taps",
   *     "database_id": "<paste-it-here>"
   *   }
   * ]
   */
}
