{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urgencemedicale",
  "compatibility_date": "2026-08-26",

  // Static-assets-only Worker: no "main" entry point, so Wrangler uploads the
  // contents of ./out (produced by `next build` with output: "export") and
  // serves them directly from Cloudflare's edge.
  //
  // The presence of this file is also what stops `wrangler deploy` from
  // running its Next.js auto-config, which previously installed the OpenNext
  // adapter and then failed looking for .next/standalone SSR artifacts that a
  // static export never produces.
  "assets": {
    "directory": "./out",
    // Serve out/404.html for unmatched paths (Next's exported 404 page).
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
