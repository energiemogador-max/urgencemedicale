{
  "rules": {
    "taps":            { ".read": "auth != null", ".write": true },
    "sessions":        { ".read": "auth != null", ".write": true },
    "online_visitors": { ".read": "auth != null", ".write": true },

    "counters":     { ".read": "auth != null", ".write": "auth != null" },
    "interventions": {
      ".read": "auth != null",
      "$id": { ".write": "auth != null" }
    },

    "staff_members": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "doctors": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || !root.child('users').exists()"
      }
    },

    "payments": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        "status": {
          ".validate": "newData.val() === 'declare' || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },

    "site_config": {
      ".read": true,
      "phone": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['call', 'whatsapp', 'at'])",
        "call":     { ".validate": "newData.isString() && newData.val().matches(/^0[5-8][0-9]{8}$/)" },
        "whatsapp": { ".validate": "newData.isString() && newData.val().matches(/^0[5-8][0-9]{8}$/)" },
        "at":       { ".validate": "newData.val() === now" },
        "$other":   { ".validate": false }
      }
    },

    "site_config_log": {
      ".read": "auth != null",
      "$id": {
        ".write": "!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['call', 'whatsapp', 'at'])"
      }
    }
  }
}
